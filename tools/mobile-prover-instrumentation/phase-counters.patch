@@ -109,6 +109,16 @@
 #[allow(unsafe_code)]
 /// Wrapper over the MSM function to use the blstrs underlying function
 pub fn msm_specific<C: CurveAffine>(coeffs: &[C::Scalar], bases: &[C::Curve]) -> C::Curve {
+    // One AM measurement rig: both arms below are counted, since aarch64 takes the
+    // blstrs fast path and only the fallback reaches `msm_best`.
+    let oneam_started = midnight_curves::oneam_profile::start();
+    let oneam_result = msm_specific_inner::<C>(coeffs, bases);
+    midnight_curves::oneam_profile::record_msm(oneam_started);
+    oneam_result
+}
+
+#[allow(unsafe_code)]
+fn msm_specific_inner<C: CurveAffine>(coeffs: &[C::Scalar], bases: &[C::Curve]) -> C::Curve {
     // We empirically checked that for MSMs larger than 2**18, the blstrs
     // implementation regresses.
     if coeffs.len() <= (2 << 18) && TypeId::of::<C>() == TypeId::of::<midnight_curves::G1Affine>() {
