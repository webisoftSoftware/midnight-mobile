diff -ruN --exclude=.cargo-ok a/midnight-curves-0.2.1/src/oneam_profile.rs b/midnight-curves-0.2.1/src/oneam_profile.rs
--- a/midnight-curves-0.2.1/src/oneam_profile.rs	1969-12-31 19:00:00
