+//! Opt-in timing counters for the One AM mobile prover.
+//!
+//! Measurement rig only -- staged by
+//! `tools/mobile-prover-instrumentation/stage.mjs` and never present in a
+//! shipped build. The counters live in `midnight-curves` because it is the
+//! lowest crate shared by the FFT, the MSM, and the PLONK prover that sits above
+//! both, so one snapshot can account for all three without threading a context
+//! through upstream signatures.
+//!
+//! Everything is off until `reset` is called, so an uninstrumented proof pays one
+//! relaxed atomic load per stage.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::Instant;
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+macro_rules! counters {
+    ($(($field:ident, $static:ident)),+ $(,)?) => {
+        $(static $static: AtomicU64 = AtomicU64::new(0);)+
+
+        /// One proof's accumulated counters, in nanoseconds unless named otherwise.
+        #[derive(Clone, Copy, Debug, Default)]
+        pub struct Snapshot {
+            $(pub $field: u64,)+
+        }
+
+        impl Snapshot {
+            /// Renders the snapshot as JSON, which is how the runtime forwards it to
+            /// the device probe without needing a serde dependency here.
+            pub fn to_json(&self) -> String {
+                let fields: &[(&str, u64)] = &[$((stringify!($field), self.$field),)+];
+                let body = fields
+                    .iter()
+                    .map(|(name, value)| format!("\"{}\":{}", name, value))
+                    .collect::<Vec<_>>()
+                    .join(",");
+                format!("{{{}}}", body)
+            }
+        }
+
+        /// Zeroes every counter and starts recording.
+        pub fn reset() {
+            ACTIVE.store(false, Ordering::SeqCst);
+            $($static.store(0, Ordering::Relaxed);)+
+            ACTIVE.store(true, Ordering::Release);
+        }
+
+        /// Stops recording and returns what was accumulated since `reset`.
+        pub fn finish() -> Snapshot {
+            ACTIVE.store(false, Ordering::Release);
+            Snapshot {
+                $($field: $static.load(Ordering::Relaxed),)+
+            }
+        }
+    };
+}
+
+counters!(
+    // The two stages that already had counters, kept so a staged run reproduces the
+    // standing S10 baseline before it decomposes anything new.
+    (msm_ns, MSM_NS),
+    (msm_calls, MSM_CALLS),
+    (fft_ns, FFT_NS),
+    (fft_calls, FFT_CALLS),
+    // The remainder, split. `create_proof_trace` first, in call order.
+    (instances_ns, INSTANCES_NS),
+    (advices_ns, ADVICES_NS),
+    (lookups_permuted_ns, LOOKUPS_PERMUTED_NS),
+    (permutation_commit_ns, PERMUTATION_COMMIT_NS),
+    (lookups_product_ns, LOOKUPS_PRODUCT_NS),
+    (trashcans_ns, TRASHCANS_NS),
+    (vanishing_commit_ns, VANISHING_COMMIT_NS),
+    (trace_polys_ns, TRACE_POLYS_NS),
+    // Then the finalising half.
+    (h_poly_ns, H_POLY_NS),
+    // `h_poly` is the largest phase, so it carries its own split: the two
+    // extended-domain coset transforms and `evaluate_h` itself.
+    (h_advice_cosets_ns, H_ADVICE_COSETS_NS),
+    (h_instance_cosets_ns, H_INSTANCE_COSETS_NS),
+    (h_evaluate_ns, H_EVALUATE_NS),
+    (vanishing_construct_ns, VANISHING_CONSTRUCT_NS),
+    (evaluations_ns, EVALUATIONS_NS),
+    (queries_ns, QUERIES_NS),
+    (multi_open_ns, MULTI_OPEN_NS),
+);
+
+/// Stage start marker. Cheap enough to take unconditionally; the read side is what
+/// checks whether recording is on.
+#[inline]
+pub fn start() -> Instant {
+    Instant::now()
+}
+
+#[inline]
+fn record(counter: &AtomicU64, started: Instant) {
+    if ACTIVE.load(Ordering::Relaxed) {
+        // Saturating rather than `try_from`: `midnight-curves` is edition 2018, so
+        // `TryFrom` is not in the prelude, and no stage outlasts 584 years.
+        let nanos = started.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+        counter.fetch_add(nanos, Ordering::Relaxed);
+    }
+}
+
+#[inline]
+fn increment(counter: &AtomicU64) {
+    if ACTIVE.load(Ordering::Relaxed) {
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+macro_rules! recorders {
+    ($(($name:ident, $counter:ident)),+ $(,)?) => {
+        $(
+            #[inline]
+            pub fn $name(started: Instant) {
+                record(&$counter, started);
+            }
+        )+
+    };
+}
+
+recorders!(
+    (record_instances, INSTANCES_NS),
+    (record_advices, ADVICES_NS),
+    (record_lookups_permuted, LOOKUPS_PERMUTED_NS),
+    (record_permutation_commit, PERMUTATION_COMMIT_NS),
+    (record_lookups_product, LOOKUPS_PRODUCT_NS),
+    (record_trashcans, TRASHCANS_NS),
+    (record_vanishing_commit, VANISHING_COMMIT_NS),
+    (record_trace_polys, TRACE_POLYS_NS),
+    (record_h_poly, H_POLY_NS),
+    (record_h_advice_cosets, H_ADVICE_COSETS_NS),
+    (record_h_instance_cosets, H_INSTANCE_COSETS_NS),
+    (record_h_evaluate, H_EVALUATE_NS),
+    (record_vanishing_construct, VANISHING_CONSTRUCT_NS),
+    (record_evaluations, EVALUATIONS_NS),
+    (record_queries, QUERIES_NS),
+    (record_multi_open, MULTI_OPEN_NS),
+);
+
+/// MSM and FFT also count calls, because a stage total is only interpretable
+/// alongside how many calls produced it.
+#[inline]
+pub fn record_msm(started: Instant) {
+    record(&MSM_NS, started);
+    increment(&MSM_CALLS);
+}
+
+#[inline]
+pub fn record_fft(started: Instant) {
+    record(&FFT_NS, started);
+    increment(&FFT_CALLS);
+}
