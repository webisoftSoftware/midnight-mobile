{
  "name": "@1am/midnight-mobile",
  "version": "0.1.0-alpha.1",
  "description": "Community-maintained Midnight wallet runtime for React Native and Expo",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./local-prover": {
      "types": "./dist/local-prover.d.ts",
      "import": "./dist/local-prover.js",
      "default": "./dist/local-prover.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist",
    "expo-module.config.json",
    "ios/MidnightMobileRuntime.podspec",
    "ios/MidnightMobileLocalProverModule.swift",
    "ios/MidnightMobileRuntimeModule.swift",
    "ios/MidnightMobileLocalProverFFI.h",
    "ios/build/MidnightMobileRuntime.xcframework",
    "ios/generated",
    "android/build.gradle",
    "android/local-prover",
    "android/src/main",
    "android/generated"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "expo": ">=55.0.0 <56.0.0",
    "expo-modules-core": ">=55.0.0 <56.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.83.0 <0.84.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "expo": "55.0.28",
    "expo-modules-core": "55.0.25",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.staging.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --import ./test-support/register-peer-stubs.mjs --test .staging-build/tests/*.test.js"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
