{
  "name": "midnight-mobile-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Midnight wallet runtime for React Native and Expo",
  "license": "MIT",
  "workspaces": [
    "packages/react-native",
    "examples/expo"
  ],
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:native": "npm run build:native:apple && npm run build:native:android",
    "build:native:android": "node scripts/native/build-android-native.mjs",
    "build:native:apple": "node scripts/native/build-apple-xcframework.mjs",
    "build:package": "npm run build --workspace @1am/midnight-mobile",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:rust": "node scripts/quality/run-rust-quality.mjs",
    "lint:workflows": "node scripts/quality/run-actionlint.mjs",
    "lint:shell": "node scripts/quality/run-shellcheck.mjs",
    "check:source-policy": "node scripts/quality/check-source-policy.mjs",
    "check:bindings": "node scripts/package/check-uniffi-bindings.mjs",
    "check:example": "npm run build --workspace @1am/midnight-mobile && npm run validate:platforms --workspace @1am/midnight-mobile-example",
    "check:native": "node scripts/native/check-apple-xcframework.mjs && node scripts/native/check-native-distribution.mjs",
    "check:package": "node scripts/package/check-react-native-package.mjs",
    "check:package:source": "node scripts/package/check-react-native-package.mjs --source-only",
    "check:release": "node scripts/release/check-release-inputs.mjs",
    "check:security": "node scripts/security/check-security.mjs",
    "generate:bindings": "node scripts/package/check-uniffi-bindings.mjs --write",
    "release:evidence": "node scripts/release/build-release-evidence.mjs",
    "release:verify": "node scripts/release/verify-release-evidence.mjs",
    "typecheck": "node scripts/quality/run-typecheck.mjs",
    "test": "node scripts/quality/run-tests.mjs --unit",
    "test:coverage": "node scripts/quality/run-tests.mjs --coverage",
    "quality:pr": "npm run format:check && npm run lint:markdown && npm run typecheck && npm run lint:ts && npm run lint:rust && npm run lint:workflows && npm run lint:shell && npm test && npm run check:package:source",
    "quality:rc": "npm run build:native && npm run quality:pr && npm run check:source-policy && npm run check:wallet-core-boundary && npm run check:bindings && npm run check:package && npm run check:native && npm run check:example && npm run check:security && npm run check:release && npm run test:coverage",
    "quality": "npm run quality:rc",
    "check:wallet-core-boundary": "node scripts/wallet-core/check-wallet-core-boundary.mjs && node scripts/wallet-core/check-wallet-core-artifacts.mjs"
  },
  "overrides": {
    "@expo/metro": "55.1.2",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=5 <6": "5.0.9",
    "js-yaml@<4": "3.15.1",
    "js-yaml@>=4 <5": "4.3.1",
    "metro": "0.83.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@tktco/node-actionlint": "1.6.0",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "55.0.1",
    "globals": "17.11.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "xcode": "3.0.1"
  }
}
