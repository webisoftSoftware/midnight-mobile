*.tgz

# Rust
target/

# Expo and React Native
.expo/
dist/
build/
.staging-build/
.declaration-build/
coverage/
android/.gradle/
tools/android-prover-spike/.gradle/
android/local.properties
packages/react-native/android/src/main/jniLibs/
ios/Pods/
ios/DerivedData/

# `expo prebuild` output. These native projects are generated from app.json and
# the installed modules, are recreated by `expo prebuild --clean`, and must not
# be committed: they embed absolute local paths and NDK build caches.
examples/expo/android/
examples/expo/ios/

# Generated release artifacts
artifacts/
*.xcarchive
*.xcframework.zip
*.aar

# Local configuration and secrets
.env
# Expo reads .env.local and .env.<mode>.local. Live endpoint URLs go there and
# must stay out of Git: an indexer or proof-server URL can identify a tenant,
# and the accepted scope forbids committing operated-service endpoints.
.env.local
.env.*.local
.env.*
!.env.example
*.key
*.pem

# Prover instrumentation rig (tools/mobile-prover-instrumentation)
/.prover-fork/
/.cargo/config.toml

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local agent instructions
/AGENTS.md
